{
  "name": "dsh-linux13-gateway",
  "version": "2.2.0",
  "description": "昆仑 IDE 1.2r / Linux 1.3 双引擎伪造工具网关：装好即在「模型」页出现一条「linux网关」供应商，上游地址与密钥都由用户自己填，插件只管转发与破限。",
  "type": "module",
  "icon": "./icon.svg",
  "main": "lib/index.js",
  "bin": {
    "linux13-gateway": "./lib/cli.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./persona-file": "./lib/persona-file.js",
    "./engine": "./lib/engine.js",
    "./server": "./lib/server.js",
    "./schema": "./lib/schema.js",
    "./cli": "./lib/cli.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "assets/*.json",
    "examples/**",
    "skills/linux13-gateway/**",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "start": "node lib/cli.js",
    "test": "node test/run-tests.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "dsh-skill",
    "kunlun-1.2r",
    "linux-1.3",
    "anti-truncation",
    "toolcall-tunnel",
    "persona-preset"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LinYoNv/dsh-linux13-gateway.git"
  },
  "homepage": "https://github.com/LinYoNv/dsh-linux13-gateway#readme",
  "license": "MIT"
}
