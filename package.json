{
  "name": "dsh-gravity",
  "version": "2.4.0",
  "description": "引力网关（Gravity）—— 昆仑 IDE 1.2r / Linux 1.3 双引擎流式破限网关（DSH 插件 + 独立可视化配置页 + 跨环境 Agent Skill）",
  "type": "module",
  "icon": "./icon.svg",
  "main": "lib/index.js",
  "bin": {
    "gravity": "./lib/cli.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./persona-file": "./lib/persona-file.js",
    "./engine": "./lib/engine.js",
    "./server": "./lib/server.js",
    "./schema": "./lib/schema.js",
    "./cli": "./lib/cli.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "assets/*.json",
    "examples/**",
    "skills/gravity/**",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "start": "node lib/cli.js",
    "test": "node test/all.mjs",
    "test:e2e": "node test/e2e.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "dsh-skill",
    "kunlun-1.2r",
    "linux-1.3",
    "anti-truncation",
    "toolcall-tunnel",
    "persona-preset"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LinYoNv/dsh-gravity.git"
  },
  "homepage": "https://github.com/LinYoNv/dsh-gravity#readme",
  "license": "MIT"
}
